# Copy this file to .env and adjust as needed for local development.

ENVIRONMENT=development

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Maximum upload size accepted by POST /api/analyze, in megabytes.
MAX_UPLOAD_SIZE_MB=20

# Google Gemini API key for LLM-powered explanations and /api/chat.
# Leave blank to disable LLM features (deterministic analysis is used instead).
# NEVER commit a real key here — this file is safe to commit.
# GEMINI_API_KEY=your-key-here
