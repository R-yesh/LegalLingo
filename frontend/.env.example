# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# Auth is passwordless magic-link email (Supabase GoTrue OTP) and profile
# data lives in the public.users table — see frontend/src/lib/supabase.ts.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
